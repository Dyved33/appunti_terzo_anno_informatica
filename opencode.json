{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "vault",
  "permission": {
    "external_directory": {
      "*": "deny"
    },
    "bash": {
      "*": "deny",
      "python3 .opencode/scripts/vault-audit.py*": "allow",
      "pdftotext*": "allow",
      "pdftoppm*": "allow",
      "pdfinfo*": "allow",
      "unzip -p*": "allow",
      "ls*": "allow",
      "file*": "allow",
      "find*": "allow",
      "wc*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "sed -n*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git blame*": "allow"
    },
    "edit": {
      "*": "deny",
      "*.md": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "question": "allow",
    "todowrite": "allow"
  }
}
