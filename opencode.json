{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen 2.5 7B (Locale)"
        },
        "qwen2.5:3b": {
          "name": "Qwen 2.5 3B (Locale)"
        },
        "qwen2.5:1.5b": {
          "name": "Qwen 2.5 1.5B (Locale)"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (Locale)"
        },
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B (Locale)"
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B (Locale)"
        },
        "llama3.2:3b": {
          "name": "Llama 3.2 3B (Locale)"
        },
        "llama3.2:1b": {
          "name": "Llama 3.2 1B (Locale)"
        },
        "gemma2:9b": {
          "name": "Gemma 2 9B (Locale)"
        },
        "gemma2:2b": {
          "name": "Gemma 2 2B (Locale)"
        }
      }
    }
  },
  "default_agent": "appunti",
  "instructions": [
    ".opencode/stile.md",
    "~/.config/opencode/vendor/i-have-adhd/skills/i-have-adhd/SKILL.md",
    "~/.config/opencode/skills/no-ai-slop/SKILL.md"
  ],
  "small_model": "ollama/qwen2.5:7b",
  "lsp": false,
  "formatter": false,
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "@plannotator/opencode@latest",
    "@azumag/opencode-rate-limit-fallback@2.1.0"
  ],
  "mcp": {
    "obsidian-search": {
      "type": "remote",
      "url": "http://127.0.0.1:8848/mcp",
      "enabled": true
    }
  },
  "compaction": {
    "auto": true
  },
  "watcher": {
    "ignore": [
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.pdf",
      "**/*.ppt",
      "**/*.pptx",
      ".git/**",
      "**/node_modules/**"
    ]
  },
  "permission": {
    "external_directory": {
      "*": "deny"
    },
    "doom_loop": "deny",
    "edit": {
      "*": "deny",
      "*.md": "allow",
      "*/esercizi/*": "deny",
      "AGENTS.md": "deny",
      ".opencode/**": "deny",
      "prompt/Guida_Opencode.md": "deny",
      "prompt/prompt_chat.md": "deny",
      "opencode.json": "deny",
      "CONFIG-CHANGES.md": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "deny",
      "python3 .opencode/scripts/vault-audit.py*": "allow",
      "python3 .opencode/scripts/leggi-slide.py*": "allow",
      "python3 .opencode/scripts/libri.py*": "allow",
      "python3 .opencode/scripts/controlla-perdite.py*": "allow",
      "python3 .opencode/scripts/dividi-appunti.py*": "allow",
      "python3 .opencode/scripts/dividi-appunti.py*--scrivi*": "ask",
      "pdfinfo*": "allow",
      "pdftotext*": "allow",
      "pdftoppm*": "ask",
      "tesseract*": "allow",
      "ls*": "allow",
      "wc*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "obsidian-mcp-search status*": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "question": "allow",
    "todowrite": "allow"
  }
}
