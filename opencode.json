{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "appunti",
  "instructions": [".opencode/stile.md"],
  "small_model": "opencode/minimax-m2.5-free",
  "lsp": false,
  "formatter": false,
  "plugin": ["@tuanhung303/opencode-acp@latest"],
  "mcp": {
    "obsidian-search": {
      "type": "remote",
      "url": "http://127.0.0.1:8848/mcp",
      "enabled": true
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 10
  },
  "watcher": {
    "ignore": [
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.pdf",
      "**/*.ppt",
      "**/*.pptx",
      ".git/**",
      "**/node_modules/**"
    ]
  }
}
