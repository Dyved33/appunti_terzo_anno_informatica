{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "appunti",
  "instructions": [
    ".opencode/stile.md",
    "~/.config/opencode/vendor/i-have-adhd/skills/i-have-adhd/SKILL.md",
    "~/.agents/skills/no-ai-slop/SKILL.md"
  ],
  "agents": {
    "title": {
      "model": "ollama/qwen2.5:7b"
    },
    "compaction": {
      "model": "ollama/qwen2.5:7b"
    }
  },
  "lsp": false,
  "formatter": false,
  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    "@plannotator/opencode@latest",
    "@azumag/opencode-rate-limit-fallback@2.1.0",
    "@omniroute/opencode-plugin"
  ],
  "mcp": {
    "servers": {
      "obsidian-search": {
        "type": "remote",
        "url": "http://127.0.0.1:8848/mcp",
        "disabled": false
      }
    }
  },
  "compaction": {
    "auto": true
  },
  "experimental": {
    "todo": true
  },
  "watcher": {
    "ignore": [
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.pdf",
      "**/*.ppt",
      "**/*.pptx",
      ".git/**",
      "**/node_modules/**"
    ]
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "doom_loop", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*.md", "effect": "allow" },
    { "action": "edit", "resource": "*/esercizi/*", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
    { "action": "edit", "resource": "prompt/Guida_Opencode.md", "effect": "deny" },
    { "action": "edit", "resource": "prompt/prompt_chat.md", "effect": "deny" },
    { "action": "edit", "resource": "prompt/README.md", "effect": "deny" },
    { "action": "edit", "resource": "CONFIG-CHANGES.md", "effect": "deny" },
    { "action": "edit", "resource": "opencode.json", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "python3 .opencode/scripts/vault-audit.py*", "effect": "allow" },
    { "action": "shell", "resource": "python3 .opencode/scripts/leggi-slide.py*", "effect": "allow" },
    { "action": "shell", "resource": "python3 .opencode/scripts/libri.py*", "effect": "allow" },
    { "action": "shell", "resource": "python3 .opencode/scripts/controlla-perdite.py*", "effect": "allow" },
    { "action": "shell", "resource": "python3 .opencode/scripts/dividi-appunti.py*", "effect": "allow" },
    { "action": "shell", "resource": "python3 .opencode/scripts/dividi-appunti.py*--scrivi*", "effect": "ask" },
    { "action": "shell", "resource": "pdfinfo*", "effect": "allow" },
    { "action": "shell", "resource": "pdftotext*", "effect": "allow" },
    { "action": "shell", "resource": "pdftoppm*", "effect": "ask" },
    { "action": "shell", "resource": "tesseract*", "effect": "allow" },
    { "action": "shell", "resource": "ls*", "effect": "allow" },
    { "action": "shell", "resource": "wc*", "effect": "allow" },
    { "action": "shell", "resource": "grep*", "effect": "allow" },
    { "action": "shell", "resource": "rg*", "effect": "allow" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "obsidian-mcp-search status*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" }
  ]
}
